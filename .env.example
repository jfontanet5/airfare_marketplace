# Copy to .env. Every key is optional: without them the app runs fully offline
# (Demo and Replay providers, FX via the keyless Frankfurter/ECB API).

# SerpApi (https://serpapi.com) — enables live Google Flights search
SERPAPI_API_KEY=
# Round trips: also fetch the return leg for the N cheapest outbound options
# (each costs one extra SerpApi request; 0 keeps searches to a single request)
SERPAPI_RETURN_LEGS_TOP_N=0

# Twelve Data (https://twelvedata.com) — preferred FX source; Frankfurter is used when absent
TWELVEDATA_API_KEY=

# Paths (defaults shown)
# AIRFARE_DB_PATH=data/price_history.sqlite
# AIRFARE_MODEL_DIR=models
