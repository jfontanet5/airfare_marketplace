# Copy to .env. Every key is optional: without them the app runs fully offline
# (Mock and Replay providers, FX via the keyless Frankfurter/ECB API).

# Amadeus Self-Service (https://developers.amadeus.com) — enables the live provider
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Twelve Data (https://twelvedata.com) — preferred FX source; Frankfurter is used when absent
TWELVEDATA_API_KEY=

# Paths (defaults shown)
# AIRFARE_DB_PATH=data/price_history.sqlite
# AIRFARE_MODEL_DIR=models
